# dependencies
node_modules/
.pnpm-store/

# build output
.next/
out/
build/
dist/
*.tsbuildinfo

# local data (SQLite demo + any PRISMA local db)
data/
*.sqlite
*.sqlite-journal
*.db
# SQLite WAL sidecars (dev.db in WAL mode) — must never be committed
*.db-shm
*.db-wal
*.db-journal

# generated prisma client
src/generated/

# tracking script bundle (generated by xt:build)
public/xt.js

# env — never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os
.DS_Store

# editor / tooling
.idea/
.vscode/
.claude/

# pull-scheduler runtime lock (single-writer, Dashboard-V2 §3) — never commit
.xacqora-pull.lock
# local scratch / evidence files
.tmp-*

# prisma migration lock (keep, but ignore local lock churn if needed)
# (do NOT ignore prisma/migrations — commit real SQL there)

# G4 scratch evidence
.g4-evidence.txt
