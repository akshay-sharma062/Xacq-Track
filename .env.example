# Xacqora Track — environment. NEVER commit real tokens or client data (spec rule 8).
# Copy to .env and fill. Secrets stay server-side only.

# --- Database -------------------------------------------------------------
# Local dev: SQLite file (used by prisma migrate + the demo seed).
DATABASE_URL="file:./dev.db"
# Production: Postgres / Supabase (Mumbai region recommended — data stays in India).
# DATABASE_URL="postgresql://user:pass@db.<ref>.mumbai.supabase.co:5432/postgres"
# PRISMA_SCHEMA_PROVIDER = "sqlite" | "postgresql"

# --- Meta -----------------------------------------------------------------
# Prefer a SYSTEM USER token (spec 5.7). Business access must include ads + leadgen.
META_ACCESS_TOKEN=""
META_LEADGEN_PAGE_ID=""
META_LEADGEN_WEBHOOK_VERIFY_TOKEN=""   # X-Hub verification token for the leadgen webhook
META_API_VERSION="v23.0"
# Comma-separated ad account IDs to pull when none are stored on the client
# yet (G1 handoff). Once AdAccount rows exist, the DB wins and this is a
# fallback only.
META_AD_ACCOUNT_IDS=""
# "1" forces the deterministic fixture pull even with a token present
# (the fallback the spec asks us to keep behind a flag).
META_SIMULATE=""

# --- FX / currency (spec 5.7: stored daily rate, no live re-convert) ------
FX_API_BASE="https://open.er-api.com"   # no API key needed; swap if you prefer
# FX cache TTL is implicit (one row per day). Nothing else to set.

# --- Jobs (G1 scheduler) ---------------------------------------------------
# Local dev TZ for the pull cadence (prod = Asia/Kolkata).
TZ="Asia/Kolkata"
# Shared secret for the durable cron trigger POST /api/jobs/pull.
# In prod, wire a platform cron (Vercel/host timer, hourly) with this header.
CRON_PULL_SECRET=""

# --- Auth / Supabase (spec 8) ---------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Public ingest API (spec: rate-limited) --------------------------------
INGEST_RATE_LIMIT_PER_MIN=120
INGEST_SHARED_SECRET=""            # per-client secrets live in the DB; this is the default

# --- Gateways (webhook secrets; stored in DB encrypted in prod) -----------
RAZORPAY_WEBHOOK_SECRET=""
CASHFREE_WEBHOOK_SECRET=""

# --- Local demo -----------------------------------------------------------
# Which demo user the app pretends to be signed in as (until Supabase Auth is wired).
DEMO_USER="arpit@foremostleads.in"
