{
  "name": "xacqora-track",
  "version": "0.1.0",
  "private": true,
  "description": "Xacqora Track — multi-tenant lead tracker & attribution CRM. Next.js 15 App Router + Prisma (SQLite local / Postgres prod) + xt.js tracking script. 10 modules, 14 screens, 14 platform adapters, Meta CAPI loop.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "tsx prisma/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "xt:build": "node xt/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.24.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
